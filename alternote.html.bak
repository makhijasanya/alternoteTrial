        <div style="flex:1"><div style="font-size:13px">View analytics</div><div style="font-size:11px;color:var(--sl);margin-top:1px">Dashboard, revenue, trends</div></div>
        <div style="width:38px;height:22px;background:var(--border);border-radius:11px;position:relative;cursor:pointer;flex-shrink:0"><div style="width:18px;height:18px;background:white;border-radius:9px;position:absolute;left:2px;top:2px;box-shadow:0 1px 3px rgba(0,0,0,.2)"></div></div>
      </div>
    </div>

    <!-- Settings -->
    <div style="margin:0 14px 10px;background:var(--wh);border:1px solid var(--border);border-radius:13px;overflow:hidden">
      <div style="padding:11px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;background:var(--bg)">
        <span style="font-size:15px">⚙️</span><div style="font-weight:600;font-size:13px">Settings</div>
      </div>
      <div style="padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center">
        <div style="flex:1"><div style="font-size:13px">Business profile</div><div style="font-size:11px;color:var(--sl);margin-top:1px">Edit boutique name, logo, address</div></div>
        <div style="width:38px;height:22px;background:var(--border);border-radius:11px;position:relative;cursor:pointer;flex-shrink:0"><div style="width:18px;height:18px;background:white;border-radius:9px;position:absolute;left:2px;top:2px;box-shadow:0 1px 3px rgba(0,0,0,.2)"></div></div>
      </div>
      <div style="padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center">
        <div style="flex:1"><div style="font-size:13px">Manage staff & roles</div><div style="font-size:11px;color:var(--sl);margin-top:1px">Add/remove staff, assign roles</div></div>
        <div style="width:38px;height:22px;background:var(--border);border-radius:11px;position:relative;cursor:pointer;flex-shrink:0"><div style="width:18px;height:18px;background:white;border-radius:9px;position:absolute;left:2px;top:2px;box-shadow:0 1px 3px rgba(0,0,0,.2)"></div></div>
      </div>
