    <div style="padding:5px 12px;border-radius:20px;font-size:12px;background:var(--cr);color:#fff;cursor:pointer">Bridal</div>
    <div style="padding:5px 12px;border-radius:20px;font-size:12px;background:var(--bg);border:1px solid var(--border);color:var(--dn);cursor:pointer">VIP</div>
    <div style="padding:5px 12px;border-radius:20px;font-size:12px;border:1.5px dashed var(--border);color:var(--sl);cursor:pointer">+ Tag</div>
  </div>
  <div class="stl">Birthday</div>
  <div style="padding:0 14px 10px"><input class="inf" type="date" value="1993-08-14" style="width:100%;box-sizing:border-box;font-size:13px"></div>
  <div class="stl">Notes</div>
  <div style="padding:0 14px 10px"><textarea class="inf" style="width:100%;box-sizing:border-box;min-height:60px;resize:none;font-size:13px;padding:12px">Prefers silk fabrics. Very particular about fitting. Call before delivery.</textarea></div>
  <div style="padding:14px"><button class="btn">Save Changes</button></div>
  <div class="mf-nav">
    <div class="mf-ni"><span>🏠</span><span>Home</span></div>
    <div class="mf-ni on"><span>👥</span><span style="color:var(--cr)">Clients</span></div>
    <div class="mf-ni"><span>📦</span><span>Orders</span></div>
    <div class="mf-ni"><span>🧾</span><span>Billing</span></div>
    <div class="mf-ni"><span>⚙️</span><span>Settings</span></div>
  </div>
</div>
</div>

<!-- ═══ TAILOR — ALTERATION DETAIL ═══ -->
<div class="screen" id="s-t-alter-detail">
<div class="mf">
  <div style="background:var(--dn);padding:14px 18px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
      <div style="color:#94a3b8;font-size:18px;cursor:pointer">←</div>
      <div style="flex:1;color:#fff;font-size:15px;font-weight:600">ALT-2025-0011</div>
      <span style="background:#eff6ff;color:#2563eb;font-size:10px;padding:3px 9px;border-radius:20px;font-weight:600">Alteration</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
      <div style="color:#94a3b8;font-size:12px">Sneha</div>
      <div style="color:#334155;font-size:11px">·</div>
      <div style="color:#94a3b8;font-size:12px">📅 12 May 2025</div>
    </div>
  </div>
  <div style="display:flex;border-bottom:1px solid var(--border);background:var(--wh)">
    <div style="flex:1;padding:11px;text-align:center;font-size:13px;font-weight:600;color:var(--cr);border-bottom:2px solid var(--cr)">Details</div>
    <div style="flex:1;padding:11px;text-align:center;font-size:13px;color:var(--sl)">Chat</div>
  </div>
  <div style="padding:12px 14px;background:var(--wh);border-bottom:1px solid var(--border)">
    <div style="font-size:11px;color:var(--sl);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">Status</div>
    <div style="display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:3px">
        <div style="width:22px;height:22px;border-radius:50%;background:var(--cr);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px">✓</div>
        <div style="height:2px;width:18px;background:var(--cr)"></div>
        <div style="width:22px;height:22px;border-radius:50%;background:var(--cr);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px">✓</div>
        <div style="height:2px;width:18px;background:var(--border)"></div>
        <div style="width:22px;height:22px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;color:var(--sl);font-size:10px">3</div>
        <div style="height:2px;width:18px;background:var(--border)"></div>
        <div style="width:22px;height:22px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;color:var(--sl);font-size:10px">4</div>
        <div style="height:2px;width:18px;background:var(--border)"></div>
        <div style="width:22px;height:22px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;color:var(--sl);font-size:10px">5</div>
      </div>
      <button style="font-size:11px;background:#eff6ff;color:#2563eb;border:none;border-radius:8px;padding:5px 10px;cursor:pointer;font-weight:500;font-family:'DM Sans',sans-serif">Mark Ready →</button>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:4px;padding:0 2px">
      <div style="font-size:9px;color:var(--cr)">Received</div>
      <div style="font-size:9px;color:var(--cr)">In Progress</div>
      <div style="font-size:9px;color:var(--sl)">Fitting</div>
      <div style="font-size:9px;color:var(--sl)">Done</div>
      <div style="font-size:9px;color:var(--sl)">Delivered</div>
    </div>
  </div>
  <div class="stl">Instructions</div>
  <div style="margin:0 14px 10px;background:#fef2f4;border-radius:11px;padding:12px 14px;border-left:3px solid var(--cr)">
    <div style="font-size:12px;color:var(--dn);line-height:1.6">Take in waist by 2 inches. Re-stitch left sleeve — seam is coming apart. Do not touch the neckline.</div>
  </div>
  <div class="stl">Measurements</div>
  <div style="margin:0 14px 12px;border:1px solid var(--border);border-radius:11px;overflow:hidden">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--bg);padding:8px 12px;font-size:10px;font-weight:600;color:var(--sl);text-transform:uppercase">
      <div>Field</div><div style="text-align:center">Current</div><div style="text-align:right">Target</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;padding:9px 12px;font-size:12px;border-top:1px solid var(--border);background:var(--wh)">
      <div>Waist</div><div style="text-align:center;color:var(--sl)">30"</div><div style="text-align:right;color:var(--success);font-weight:500">28" <span style="color:var(--sl);font-size:10px">-2"</span></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;padding:9px 12px;font-size:12px;border-top:1px solid var(--border);background:var(--wh)">
      <div>Left Sleeve</div><div style="text-align:center;color:var(--sl)">24"</div><div style="text-align:right;color:var(--sl);font-weight:500">24" <span style="font-size:10px">—</span></div>
    </div>
  </div>
  <div class="mf-nav">
    <div class="mf-ni on"><span>🪡</span><span style="color:var(--cr)">My Orders</span></div>
    <div class="mf-ni"><span>💬</span><span>Chats</span></div>
    <div class="mf-ni"><span>⚙️</span><span>Settings</span></div>
  </div>
</div>
</div>


<!-- ═══ SETTINGS — ROLES & PERMISSIONS ═══ -->
<div class="screen" id="s-settings-roles">
<div class="mf" style="display:flex;flex-direction:column">
  <div class="sh" style="background:var(--wh)">
    <button style="width:30px;height:30px;border-radius:7px;background:var(--bg);border:none;cursor:pointer">←</button>
    <h1>Roles & Permissions</h1>
    <button style="background:var(--cr);color:#fff;border:none;border-radius:9px;padding:6px 12px;font-size:12px;cursor:pointer;font-family:'DM Sans',sans-serif" onclick="show(null,'settings-role-edit','New Role','Admin')">+ New</button>
  </div>
  <div style="flex:1;overflow-y:auto">
    <div style="margin:10px 14px;background:#eff6ff;border-radius:10px;padding:10px 12px;font-size:11px;color:#2563eb;line-height:1.6">
