        </div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">Orders (view)</span>
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">Measurements (view)</span>
      </div>
    </div>
