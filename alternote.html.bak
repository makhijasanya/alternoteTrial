    <div style="margin:4px 14px 20px;border:1.5px dashed var(--border);border-radius:13px;padding:14px;display:flex;align-items:center;gap:10px;cursor:pointer" onclick="show(null,'settings-role-edit','New Role','Admin')">
      <div style="width:36px;height:36px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:16px">🛡️</div>
