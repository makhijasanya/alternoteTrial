    </div>
  </div>
  <div class="wf-body" style="align-items:center;justify-content:center;min-height:500px">
    <div style="text-align:center;padding:60px 40px">
      <div style="font-size:56px;margin-bottom:16px">🚫</div>
      <div style="font-family:'DM Serif Display',serif;font-size:26px;color:var(--dn);margin-bottom:10px">Web access is Admin only</div>
      <div style="font-size:14px;color:var(--sl);max-width:380px;margin:0 auto;line-height:1.7">Your account (Ramesh Kumar — Tailor) does not have access to the web dashboard. Only Admin roles can log in here.</div>
      <div style="margin-top:28px;padding:16px 20px;background:#fef2f4;border-radius:12px;border:1px solid #fecdd3;display:inline-block;text-align:left;min-width:300px">
        <div style="font-size:12px;font-weight:600;color:var(--cr);margin-bottom:5px">Please use the mobile app</div>
        <div style="font-size:12px;color:#be123c;line-height:1.5">Download the Alternote app on your phone to access your orders and chats.</div>
      </div>
      <div style="margin-top:24px">
        <button style="background:var(--cr);color:#fff;border:none;border-radius:9px;padding:10px 24px;font-size:14px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif">← Back to Login</button>
      </div>
    </div>
  </div>
</div>
</div>

</div>

<script>
function show(el, id, title, badge) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const screen = document.getElementById('s-' + id) || document.getElementById(id);
  if (screen) screen.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
  if (el) el.classList.add('active');
  const t = document.getElementById('stitle');
  const b = document.getElementById('sbadge');
  if (t) t.textContent = title;
  if (b) b.textContent = badge;
}
</script>
</body>
</html>
