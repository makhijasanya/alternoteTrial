    </div>
    <div class="stl">Default Roles</div>
    <!-- Admin -->
    <div style="margin:0 14px 8px;background:var(--wh);border:1px solid var(--border);border-radius:13px;padding:13px 14px">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:36px;height:36px;border-radius:10px;background:#fef2f4;display:flex;align-items:center;justify-content:center;font-size:17px">👑</div>
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:6px">
            <div style="font-weight:600;font-size:14px">Admin</div>
            <div style="font-size:10px;color:var(--sl);background:var(--bg);border-radius:4px;padding:2px 6px">Default</div>
            <div style="font-size:11px;color:var(--sl);margin-left:auto">🔒</div>
          </div>
          <div style="font-size:11px;color:var(--sl);margin-top:3px">1 member · Full access</div>
        </div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">All Modules</span>
      </div>
    </div>
    <!-- Assistant -->
    <div style="margin:0 14px 8px;background:var(--wh);border:1px solid var(--border);border-radius:13px;padding:13px 14px">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:36px;height:36px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;font-size:17px">🙋</div>
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:6px">
            <div style="font-weight:600;font-size:14px">Assistant</div>
            <div style="font-size:10px;color:var(--sl);background:var(--bg);border-radius:4px;padding:2px 6px">Default</div>
            <div style="font-size:11px;color:var(--sl);margin-left:auto">🔒</div>
          </div>
          <div style="font-size:11px;color:var(--sl);margin-top:3px">1 member · No billing</div>
        </div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">Clients</span>
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">Orders</span>
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">Measurements</span>
        <span style="font-size:10px;background:var(--bg);color:var(--sl);padding:3px 8px;border-radius:20px">Analytics</span>
      </div>
    </div>
    <!-- Tailor -->
    <div style="margin:0 14px 8px;background:var(--wh);border:1px solid var(--border);border-radius:13px;padding:13px 14px">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:36px;height:36px;border-radius:10px;background:#ecfdf5;display:flex;align-items:center;justify-content:center;font-size:17px">🪡</div>
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:6px">
            <div style="font-weight:600;font-size:14px">Tailor</div>
            <div style="font-size:10px;color:var(--sl);background:var(--bg);border-radius:4px;padding:2px 6px">Default</div>
            <div style="font-size:11px;color:var(--sl);margin-left:auto">🔒</div>
          </div>
