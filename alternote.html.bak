        <div style="flex:1"><div style="font-size:13px">Bill Generation & View Order History</div><div style="font-size:11px;color:var(--sl);margin-top:1px">Create invoices, record payments, view all order history</div></div>
        <div style="width:38px;height:22px;background:var(--border);border-radius:11px;position:relative;cursor:pointer;flex-shrink:0"><div style="width:18px;height:18px;background:white;border-radius:9px;position:absolute;left:2px;top:2px;box-shadow:0 1px 3px rgba(0,0,0,.2)"></div></div>
      </div>
      <div style="padding:8px 14px 6px;background:var(--bg);border-bottom:1px solid var(--border)">
