  <div style="padding:0 14px 6px"><input class="inf" placeholder="rzp_live_xxxxxxxxxxxx" style="width:100%;box-sizing:border-box;font-family:monospace;font-size:12px;letter-spacing:0.5px"></div>
  <div style="padding:0 14px 14px;font-size:11px;color:var(--sl)">Use your <strong>Live</strong> key for real payments. Test key (rzp_test_...) for sandbox.</div>
  <!-- CTA -->
