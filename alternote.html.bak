    <button style="width:100%;background:var(--cr);color:#fff;border:none;border-radius:12px;padding:14px;font-size:14px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif">Connect & Verify</button>
  </div>
  <div style="padding:0 14px 20px;text-align:center">
