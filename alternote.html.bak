      <span style="color:#fff;font-size:24px;font-weight:700">R</span>
    </div>
    <div style="font-family:'DM Serif Display',serif;font-size:20px;color:var(--dn);margin-bottom:6px">Accept payments digitally</div>
    <div style="font-size:12px;color:var(--sl);line-height:1.6;max-width:280px;margin:0 auto">Send a Razorpay payment link via WhatsApp. Your clients pay via UPI, card, or net banking — no app needed.</div>
  </div>
  <!-- Why Razorpay -->
  <div style="padding:14px">
    <div style="background:var(--wh);border:1px solid var(--border);border-radius:12px;overflow:hidden">
      <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border)">
        <span style="font-size:16px">🇮🇳</span>
        <div style="font-size:12px;color:var(--dn)"><strong>India-first</strong> — UPI, NEFT, cards, wallets all in one link</div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border)">
        <span style="font-size:16px">📲</span>
        <div style="font-size:12px;color:var(--dn)"><strong>WhatsApp-ready</strong> — short rzp.io link, no redirects</div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border)">
        <span style="font-size:16px">⚡</span>
        <div style="font-size:12px;color:var(--dn)"><strong>T+1 settlements</strong> — money hits your bank next day</div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;padding:11px 14px">
        <span style="font-size:16px">🔒</span>
        <div style="font-size:12px;color:var(--dn)"><strong>2% per transaction</strong> — no monthly fee, no setup cost</div>
      </div>
    </div>
  </div>
  <!-- Setup steps -->
  <div class="stl">How it works</div>
  <div style="padding:0 14px 14px;display:flex;flex-direction:column;gap:8px">
    <div style="display:flex;align-items:flex-start;gap:10px">
      <div style="width:22px;height:22px;border-radius:50%;background:var(--cr);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px">1</div>
      <div style="font-size:12px;color:var(--dn);line-height:1.5">Create a free Razorpay account at razorpay.com — takes 5 min with PAN + bank details</div>
    </div>
    <div style="display:flex;align-items:flex-start;gap:10px">
      <div style="width:22px;height:22px;border-radius:50%;background:var(--cr);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px">2</div>
      <div style="font-size:12px;color:var(--dn);line-height:1.5">Copy your API Key from Razorpay Dashboard → Settings → API Keys</div>
    </div>
    <div style="display:flex;align-items:flex-start;gap:10px">
      <div style="width:22px;height:22px;border-radius:50%;background:var(--cr);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px">3</div>
      <div style="font-size:12px;color:var(--dn);line-height:1.5">Paste it below and Alternote handles the rest</div>
    </div>
  </div>
  <!-- API Key entry -->
